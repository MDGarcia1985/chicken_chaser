{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "detection",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "box": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 8192
      },
      "minItems": 4,
      "maxItems": 4
    },
    "coordinates": {
      "const": "xyxy_pixels_processing_view"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "frame_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "received_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000000.0
    },
    "capture_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000000.0
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_bound_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "label",
    "confidence",
    "box",
    "coordinates",
    "width",
    "height",
    "frame_id",
    "received_ms",
    "capture_ms",
    "latency_bound_ms"
  ],
  "additionalProperties": false
}
