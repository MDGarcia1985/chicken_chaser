{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "telemetry",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "session": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "ack_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "state": {
      "enum": [
        "DISARMED",
        "TRACKING",
        "BLOCKED",
        "FAULT"
      ]
    },
    "commanded": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "front": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "valid",
            "invalid",
            "stale",
            "unavailable"
          ]
        },
        "distance_mm": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 8000
            },
            {
              "type": "null"
            }
          ]
        },
        "age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "distance_mm",
        "age_ms"
      ],
      "additionalProperties": false
    },
    "rear": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "valid",
            "invalid",
            "stale",
            "unavailable"
          ]
        },
        "distance_mm": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 8000
            },
            {
              "type": "null"
            }
          ]
        },
        "age_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "distance_mm",
        "age_ms"
      ],
      "additionalProperties": false
    },
    "fault": {
      "type": "string"
    },
    "physical_outputs": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "session",
    "generation",
    "ack_sequence",
    "state",
    "commanded",
    "applied",
    "front",
    "rear",
    "fault",
    "physical_outputs"
  ],
  "additionalProperties": false
}
